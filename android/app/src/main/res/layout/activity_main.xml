<?xml version="1.0" encoding="utf-8"?>
<!--
  All of the app's screens. MainActivity shows one at a time: screenUnpaired, screenHome,
  screenWorking (hold the tag), screenResult and screenKnurd (status, tags, taps).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- ===================== First run: not paired ===================== -->
        <LinearLayout
            android:id="@+id/screenUnpaired"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    style="@style/Knura.Text.Brand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/Knura.Pill"
                    android:background="@drawable/bg_pill_neutral"
                    android:drawableStart="@drawable/dot_neutral"
                    android:text="@string/not_paired_pill"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Knura.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pair_title" />

            <TextView
                style="@style/Knura.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/pair_lead" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                style="@style/Knura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_step_number"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/accent_text"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Knura.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="26dp"
                            android:gravity="center_vertical"
                            android:text="@string/pair_step_1"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Knura.Text.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_code"
                            android:padding="10dp"
                            android:text="@string/pair_command"
                            android:textColor="@color/code_text"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_step_number"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/accent_text"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Knura.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/pair_step_2"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/unpairedNotice"
                style="@style/Knura.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone" />

            <Button
                android:id="@+id/pair"
                style="@style/Knura.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/pair" />
        </LinearLayout>

        <!-- ===================== Home: paired ===================== -->
        <LinearLayout
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    style="@style/Knura.Text.Brand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/Knura.Pill"
                    android:background="@drawable/bg_pill_good"
                    android:drawableStart="@drawable/dot_good"
                    android:text="@string/paired_pill"
                    android:textColor="@color/ok_text" />
            </LinearLayout>

            <!-- Two columns side by side when the Fold is open; MainActivity switches the orientation. -->
            <LinearLayout
                android:id="@+id/homeColumns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeTagColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Knura.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_box"
                                android:importantForAccessibility="no"
                                android:scaleType="center"
                                android:src="@drawable/ic_server" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Knura.Text.Overline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/your_knurd"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/knurdUrl"
                                    style="@style/Knura.Text.Mono"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="middle"
                                    android:singleLine="true"
                                    android:textColor="@color/fg" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/forget"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="48dp"
                                android:text="@string/forget"
                                android:textAllCaps="false"
                                android:textColor="@color/muted"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/Knura.Text.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:text="@string/knurd_security" />
                    </LinearLayout>

                    <TextView
                        style="@style/Knura.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/what_to_do" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileProvision"
                            style="@style/Knura.Tile"
                            android:layout_marginEnd="5dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_provision" />

                            <TextView
                                style="@style/Knura.TileTitle"
                                android:text="@string/action_provision" />

                            <TextView
                                style="@style/Knura.TileHint"
                                android:text="@string/action_provision_hint" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileInfo"
                            style="@style/Knura.Tile"
                            android:layout_marginStart="5dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info" />

                            <TextView
                                style="@style/Knura.TileTitle"
                                android:text="@string/action_info" />

                            <TextView
                                style="@style/Knura.TileHint"
                                android:text="@string/action_info_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileTap"
                            style="@style/Knura.Tile"
                            android:layout_marginEnd="5dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check" />

                            <TextView
                                style="@style/Knura.TileTitle"
                                android:text="@string/action_tap" />

                            <TextView
                                style="@style/Knura.TileHint"
                                android:text="@string/action_tap_hint" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileReset"
                            style="@style/Knura.Tile"
                            android:layout_marginStart="5dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_reset" />

                            <TextView
                                style="@style/Knura.TileTitle"
                                android:text="@string/action_reset" />

                            <TextView
                                style="@style/Knura.TileHint"
                                android:text="@string/action_reset_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileClaim"
                            style="@style/Knura.Tile">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_claim" />

                            <TextView
                                style="@style/Knura.TileTitle"
                                android:text="@string/action_claim" />

                            <TextView
                                style="@style/Knura.TileHint"
                                android:text="@string/action_claim_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/knuraKeys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_switch_row"
                        android:minHeight="52dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/knura_keys"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/start"
                        style="@style/Knura.Button.Primary"
                        android:layout_marginTop="12dp"
                        android:text="@string/start" />

                    <TextView
                        android:id="@+id/homeNotice"
                        style="@style/Knura.Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textIsSelectable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeKnurdColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Knura.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/knurd" />

                    <LinearLayout
                        android:id="@+id/knurdMenu"
                        style="@style/Knura.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:id="@+id/knurdStatus"
                            style="@style/Knura.Row">

                            <ImageView
                                style="@style/Knura.RowIcon"
                                android:src="@drawable/ic_status" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Knura.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_status" />

                                <TextView
                                    style="@style/Knura.Text.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_status_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView style="@style/Knura.Chevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/knurdTags"
                            style="@style/Knura.Row">

                            <ImageView
                                style="@style/Knura.RowIcon"
                                android:src="@drawable/ic_tags" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Knura.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_tags" />

                                <TextView
                                    style="@style/Knura.Text.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_tags_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView style="@style/Knura.Chevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/knurdTaps"
                            style="@style/Knura.Row">

                            <ImageView
                                style="@style/Knura.RowIcon"
                                android:src="@drawable/ic_taps" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Knura.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_taps" />

                                <TextView
                                    style="@style/Knura.Text.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_taps_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView style="@style/Knura.Chevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/knurdTokens"
                            style="@style/Knura.Row">

                            <ImageView
                                style="@style/Knura.RowIcon"
                                android:src="@drawable/ic_key" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Knura.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_tokens" />

                                <TextView
                                    style="@style/Knura.Text.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/knurd_tokens_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView style="@style/Knura.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Working: hold the tag ===================== -->
        <LinearLayout
            android:id="@+id/screenWorking"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/workAction"
                style="@style/Knura.Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <FrameLayout
                android:id="@+id/target"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/tag_target">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nfc" />
            </FrameLayout>

            <TextView
                android:id="@+id/workTitle"
                style="@style/Knura.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/hold_title"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/workHint"
                style="@style/Knura.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hold_hint" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <LinearLayout
                style="@style/Knura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp">

                        <ImageView
                            android:id="@+id/step1Icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="center" />

                        <ProgressBar
                            android:id="@+id/step1Spin"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/accent_stroke"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/step1Text"
                        style="@style/Knura.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/step_unlocked"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp">

                        <ImageView
                            android:id="@+id/step2Icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="center" />

                        <ProgressBar
                            android:id="@+id/step2Spin"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/accent_stroke"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/step2Text"
                        style="@style/Knura.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/step_waiting"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp">

                        <ImageView
                            android:id="@+id/step3Icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="center" />

                        <ProgressBar
                            android:id="@+id/step3Spin"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/accent_stroke"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/step3Text"
                        style="@style/Knura.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/cancel"
                style="@style/Knura.Button.Outline"
                android:layout_marginTop="16dp"
                android:text="@string/cancel" />
        </LinearLayout>

        <!-- ===================== Result of a tag session ===================== -->
        <LinearLayout
            android:id="@+id/screenResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resultAction"
                    style="@style/Knura.Text.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/resultClose"
                    style="@style/Knura.IconButton"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/resultIconBox"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_result_good">

                <ImageView
                    android:id="@+id/resultIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_ok" />
            </FrameLayout>

            <TextView
                android:id="@+id/resultTitle"
                style="@style/Knura.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/resultSubtitle"
                style="@style/Knura.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/resultRows"
                style="@style/Knura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <LinearLayout
                android:id="@+id/logBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_code"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/logToggle"
                    style="@style/Knura.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/what_knurd_did"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/log"
                    style="@style/Knura.Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copy"
                    style="@style/Knura.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/copy_details"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/again"
                    style="@style/Knura.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== knurd's answers: status, tags, taps ===================== -->
        <LinearLayout
            android:id="@+id/screenKnurd"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/knurdBack"
                    style="@style/Knura.IconButton"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:id="@+id/knurdTitle"
                    style="@style/Knura.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/knurdNote"
                style="@style/Knura.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/knurdLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/accent_stroke"
                android:visibility="gone" />

            <TextView
                android:id="@+id/knurdMessage"
                style="@style/Knura.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/knurdRows"
                style="@style/Knura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
